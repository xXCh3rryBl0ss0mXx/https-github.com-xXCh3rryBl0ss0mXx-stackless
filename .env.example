# Clerk keys — copy this file to `.env.local` and paste values from the Clerk Dashboard.
# Never commit real keys. Preview/production need the same names in Vercel.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# After sign-in / sign-up, send people to the marketing home
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Product data. Default is an empty in-memory store (local / CI, no database).
# Production: STACKLESS_DATA_STORE=neon and DATABASE_URL (Neon Postgres).
# postgres is an alias for neon. sheets is a legacy option (see below).
STACKLESS_DATA_STORE=memory

# --- Neon Postgres (recommended for Production). Server-only — never NEXT_PUBLIC_. ---
# The app still builds without this. Set STACKLESS_DATA_STORE=neon only after
# DATABASE_URL is filled. Missing URL in neon mode shows a peach error on /app.
# Early-access waitlist emails are written to Neon (waitlist_signups), so
# production needs these two vars or the form will say the email was not saved.
# 1. Create a free project at https://console.neon.tech
# 2. Dashboard → Connect → copy the connection string (prefer Pooled connection)
# 3. Paste it here. Optional: run data/schema.sql in Neon’s SQL Editor
#    (the app also CREATE TABLE IF NOT EXISTS on first use).
DATABASE_URL=

# --- Resend (Today’s List → Send email). Leave blank until you have a real key. ---
# The app still builds without these. Send email fails with a clear “add RESEND_API_KEY”
# (or RESEND_FROM_EMAIL) message until you fill them in.
# 1. Open https://resend.com/api-keys and create an API key. Paste it below.
# 2. From address: Resend only sends from a verified domain, or their test address.
#    Tests: Stackless <onboarding@resend.dev> (can only send to the email on your Resend account)
#    Real clients: verify a domain at https://resend.com/domains, then use e.g. Stackless <hello@yourdomain.com>
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Vercel Cron (Today’s List → send later) ---
# Required in Production so daily cron can send due drafts.
# Hobby allows once per day (`0 15 * * *` in vercel.json = 15:00 UTC ≈ 8am PT).
# Pro can bump that schedule to hourly later. Never NEXT_PUBLIC_.
# Generate a long random string (e.g. `openssl rand -hex 32`).
# Vercel sends `Authorization: Bearer <CRON_SECRET>` automatically when this is set.
# Cron still builds without it; the route returns 401 until it is set.
CRON_SECRET=

# --- Google Sheets (legacy / optional; Neon is the recommended production store) ---
# The app still builds without these. Set STACKLESS_DATA_STORE=sheets only after
# the three values below are filled. Credentials stay server-side — never NEXT_PUBLIC_.
# Steps: data/README.md
# 1. Copy data/leads.csv, invoices.csv, nudge_log.csv into one Google Sheet
#    (tabs named leads, invoices, nudge_log — keep the header row names).
# 2. Google Cloud Console → IAM → Service Accounts → create one → JSON key.
# 3. Share the Sheet with that service account email as Editor.
# 4. Paste the spreadsheet id (from the Sheet URL), the service account email,
#    and the private key. If the key is one line, keep the \n sequences.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Stripe ($19/month subscription). Leave blank until you have a real Price. ---
# The app still builds without these. /app shows a peach paywall (Checkout disabled)
# until STRIPE_SECRET_KEY and STRIPE_PRICE_ID are set. Never prefix secret values
# with NEXT_PUBLIC_ — only the publishable key is allowed in the browser.
# 1. Stripe Dashboard → Product catalog → Add product “Stackless”
#    Recurring price: $19 USD / month. Copy the Price id (starts with price_).
# 2. Developers → API keys → Secret key (sk_test_ / sk_live_) and Publishable key (pk_).
# 3. Developers → Webhooks → Add endpoint https://www.stackless.lol/api/stripe/webhook
#    Events: checkout.session.completed, customer.subscription.updated,
#    customer.subscription.deleted. Copy the endpoint Signing secret (whsec_).
# 4. Settings → Billing → Customer portal: allow cancel + update payment method.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
