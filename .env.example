# Clerk keys — copy this file to `.env.local` and paste values from the Clerk Dashboard.
# Never commit real keys. Preview/production need the same names in Vercel.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# After sign-in / sign-up, send people to the marketing home
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Product data. Default is the seed CSVs in /data (no Google account needed).
STACKLESS_DATA_STORE=memory

# --- Resend (Today’s List → Send email). Leave blank until you have a real key. ---
# The app still builds without these. Send email fails with a clear “add RESEND_API_KEY”
# (or RESEND_FROM_EMAIL) message until you fill them in.
# 1. Open https://resend.com/api-keys and create an API key. Paste it below.
# 2. From address: Resend only sends from a verified domain, or their test address.
#    Tests: Stackless <onboarding@resend.dev> (can only send to the email on your Resend account)
#    Real clients: verify a domain at https://resend.com/domains, then use e.g. Stackless <hello@yourdomain.com>
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Google Sheets (later; leave blank until you connect a real Sheet) ---
# 1. Copy data/leads.csv, invoices.csv, nudge_log.csv into one Sheet (see data/README.md)
# 2. Create a Google Cloud service account and share the Sheet with that email
# 3. Fill these in, then implement SheetsDataStore and set STACKLESS_DATA_STORE=sheets
#    (the stub throws on purpose today — there are no sample keys)
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
