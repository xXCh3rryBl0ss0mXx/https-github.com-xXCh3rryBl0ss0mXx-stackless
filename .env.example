# Clerk keys — copy this file to `.env.local` and paste values from the Clerk Dashboard.
# Never commit real keys. Preview/production need the same names in Vercel.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# After sign-in / sign-up, send people to the marketing home
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Product data. Default is an empty in-memory store (no Google account needed).
# Leave this as memory for Preview/Production until a Sheet is connected.
STACKLESS_DATA_STORE=memory

# --- Resend (Today’s List → Send email). Leave blank until you have a real key. ---
# The app still builds without these. Send email fails with a clear “add RESEND_API_KEY”
# (or RESEND_FROM_EMAIL) message until you fill them in.
# 1. Open https://resend.com/api-keys and create an API key. Paste it below.
# 2. From address: Resend only sends from a verified domain, or their test address.
#    Tests: Stackless <onboarding@resend.dev> (can only send to the email on your Resend account)
#    Real clients: verify a domain at https://resend.com/domains, then use e.g. Stackless <hello@yourdomain.com>
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Vercel Cron (Today’s List → send later) ---
# Required in Production/Preview so hourly cron can send due drafts.
# Generate a long random string (e.g. `openssl rand -hex 32`). Never NEXT_PUBLIC_.
# Vercel sends `Authorization: Bearer <CRON_SECRET>` automatically when this is set.
# Cron still builds without it; the route returns 401 until it is set.
CRON_SECRET=

# --- Google Sheets (optional; leave blank and keep STACKLESS_DATA_STORE=memory) ---
# The app still builds without these. Set STACKLESS_DATA_STORE=sheets only after
# the three values below are filled. Credentials stay server-side — never NEXT_PUBLIC_.
# Steps: data/README.md
# 1. Copy data/leads.csv, invoices.csv, nudge_log.csv into one Google Sheet
#    (tabs named leads, invoices, nudge_log — keep the header row names).
# 2. Google Cloud Console → IAM → Service Accounts → create one → JSON key.
# 3. Share the Sheet with that service account email as Editor.
# 4. Paste the spreadsheet id (from the Sheet URL), the service account email,
#    and the private key. If the key is one line, keep the \n sequences.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
